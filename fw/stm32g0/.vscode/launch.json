{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with OpenOCD",
            "preLaunchTask": "Build Debug",
            "cwd": "${workspaceFolder}",
            "executable": "_build/debug/ws2812b-light.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface-${input:debugProbe}.cfg",
                "target-stm32g0x.cfg"
            ],
            "searchDir": ["${workspaceFolder}/.vscode/openocd"],
            "postLaunchCommands": [
                "source ${workspaceFolder}/.vscode/start-application.gdb"
            ],
            "postResetCommands": [
                "source ${workspaceFolder}/.vscode/start-application.gdb"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Run Release with OpenOCD",
            "preLaunchTask": "Build Release",
            "cwd": "${workspaceFolder}",
            "executable": "_build/release/ws2812b-light.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "configFiles": [
                "interface-${input:debugProbe}.cfg",
                "target-stm32g0x.cfg"
            ],
            "searchDir": ["${workspaceFolder}/.vscode/openocd"],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug with ST-Link",
            "preLaunchTask": "Build Debug",
            "cwd": "${workspaceFolder}",
            "executable": "_build/debug/ws2812b-light.elf",
            "postLaunchCommands": [
                "source ${workspaceFolder}/.vscode/start-application.gdb"
            ],
            "postResetCommands": [
                "source ${workspaceFolder}/.vscode/start-application.gdb"
            ],
            "device": "STM32G070K8",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 10
            },
            "servertype": "stlink"
        },
        {
            "name": "Run Release with ST-Link",
            "preLaunchTask": "Build Release",
            "cwd": "${workspaceFolder}",
            "executable": "_build/release/ws2812b-light.elf",
            "device": "STM32G070K8",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink"
        }
    ],
    "inputs": [
        {
            "id": "debugProbe",
            "type": "pickString",
            "description": "Select the debug probe for OpenOCD",
            "options": [
                {
                    "label": "Raspberry Pi Debug Probe",
                    "value": "rpi-debug-probe"
                },
                {
                    "label": "ST-Link (SWD)",
                    "value": "stlink-swd"
                }
            ],
            "default": "rpi-debug-probe"
        }
    ]
}